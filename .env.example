# ── Supabase ──────────────────────────────────────────────────────────────
# Public — safe to expose to the browser. From: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only — NEVER expose to the browser. Used by the seed script and by
# admin server actions that need to bypass RLS (e.g. storage cleanup).
# From: Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Storage bucket that holds logos / hero images / PDFs (created by the migration)
NEXT_PUBLIC_SUPABASE_BUCKET=media
