# ── Supabase ──────────────────────────────────────────────────────────────
# Public — safe to expose to the browser. From: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only — NEVER expose to the browser. Used by the seed script and by
# admin server actions that need to bypass RLS (e.g. storage cleanup).
# From: Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Storage bucket that holds logos / hero images / PDFs (created by the migration)
NEXT_PUBLIC_SUPABASE_BUCKET=media

# ── Email (مجتمع الأستاذ broadcasts) ──────────────────────────────────────
# Optional: without RESEND_API_KEY the site works exactly as before — members
# still join and ideas still arrive, but the dashboard cannot send broadcasts
# and no welcome email goes out. Use the CSV export in the meantime.
# From: https://resend.com → API Keys
RESEND_API_KEY=

# The From: header on community mail. The domain must be verified in Resend.
COMMUNITY_FROM_EMAIL="مجتمع الأستاذ <community@ostath.sa>"

# Absolute site origin, used to build unsubscribe links inside emails.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://ostath.sa
